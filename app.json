{
  "expo": {
    "name": "dreamlodge-frontend",
    "slug": "dreamlodge",
    "owner": "angllibertos-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dreamlodgefrontend",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "updates": {
      "enabled": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.dreamlodgeapp.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "BACKEND_URL": "https://impressive-cathee-immune-angelceb-312ac472.koyeb.app",
      "eas": {
        "projectId": "72406e94-1111-43fa-98b4-284e34852e48"
      }
    }
  }
}
